@startuml
' ─────────────────────────────────────────────
' Physical Node: User's Desktop Machine
' ─────────────────────────────────────────────
node "User's Desktop Machine" as Desktop <<device>> {

  node "Operating System\n(Linux)" as OS {

    ' ── Application Components ─────────────────
    component "GUI Module\n(gui2.py, guievents2.py)" as GUIModule <<artifact>> {
    }

    component "Backend Modules\n(course.py, semester.py, tags.py)" as BackendModule <<artifact>> {
    }

    ' ── File System ────────────────────────────
    folder "Local File System\n(CMU/ directory structure)" as FileSystem
  }

}

' ─────────────────────────────────────────────
' Connections
' ─────────────────────────────────────────────
GUIModule -down-> BackendModule : User interactions
BackendModule -down-> FileSystem : File operations (sort, organize)

BackendModule -up-> GUIModule : Status updates
FileSystem -up-> BackendModule : File access results

@enduml
