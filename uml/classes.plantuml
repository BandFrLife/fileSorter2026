' UML Diagram for Semester, Course, Tag, GUI, and Eventhandler

@startuml
class Semester {
    - _year : int
    - _season : str
    - _courses : list[Course]
    + year() : int
    + year(val : int)
    + season() : str
    + season(val : str)
    + courses() : list[Course]
    + courses(val : list[Course])
    + print_courses() : None
    + add_course(course : Course) : None
    + remove_course(course : Course) : None
    + clear_courses() : None
    + __str__() : str
}

class Course {
    - _name : str
    - _number : int
    - _dept : Tag
    + name() : str
    + name(val : str)
    + number() : int
    + number(val : int)
    + dept() : Tag
    + dept(val : Tag)
    + __str__() : str
}

class Tag {
    - _name : str
    - _desc : str
    + set_name(name : str) : None
    + set_description(desc : str) : None
    + name() : str
    + desc() : str
    + __str__() : str
}

class GUI {
    - _instance : GUI | None
    - default_tags : list[str]
    - semesters : list[str]
    - events : Eventhandler
    + __new__(*args, **kwargs) : GUI
    + __init__() : None
    + makewindow() : None
}

class Eventhandler {
    - source_dir : Path | None
    - project_root : Path
    - current_year : str
    + __init__() : None
    + prepfilestruct() : None
    + populatelist(box : tk.Listbox) : None
    + add_tag(tag_entry : tk.Entry, tag_box : tk.Listbox) : None
    + savefileas(filelist : tk.Listbox, semester : str, 
                    course_name : str, tag_box : tk.Listbox) : None
}


@enduml
